# ============================================================================
# HOMETOWN HUB — ENVIRONMENT VARIABLES TEMPLATE
#
# 👉 CONCEPT: ".env" files store SECRETS and per-machine config (passwords,
#    API keys). They are loaded by the server at startup, never shipped to
#    the browser, and NEVER committed to git (see .gitignore).
#
# Setup: copy this file to a new file called `.env` and fill in real values.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# PostgreSQL connection string.
#   Local:    postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   Hosted:   copy it from your provider (Neon/Supabase/Render) — it looks like
#             postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Secret used to SIGN the JWT login tokens. Any long random string works.
# Generate one with:  openssl rand -base64 32
# If it's weak/leaked, anyone could forge login tokens — keep it private!
JWT_SECRET="change-me-to-a-long-random-string"

# --- OPTIONAL (image uploads via Cloudinary) ---------------------------------
# With these three set, uploaded images go to your Cloudinary cloud.
# Without them, images are stored as base64 data URLs in the database
# (fine for learning; switch to Cloudinary before real traffic).
#
# Free keys (2-minute setup):
#   1. Go to https://cloudinary.com and Sign up (free tier: ~25 credits/month)
#   2. Open the Dashboard → "Account Details" / "Programmable Media"
#   3. Copy the Cloud Name, API Key and API Secret below.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
